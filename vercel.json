{
  "cleanUrls": true,
  "redirects": [
    {
      "has": [
        {
          "type": "host",
          "value": "www.manufaktur.biz.id"
        }
      ],
      "source": "/(.*)",
      "destination": "https://manufaktur.biz.id/$1",
      "permanent": true
    },
    {
      "source": "/20:year(\\d{2})/(.*)",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/search/(.*)",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/feeds/(.*)",
      "destination": "/rss.xml",
      "permanent": true
    },
    {
      "source": "/p/(.*)",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/lalu",
      "destination": "/departures",
      "permanent": true
    },
    {
      "source": "/jadwal",
      "destination": "/flights",
      "permanent": true
    },
    {
      "source": "/bandara",
      "destination": "/airports",
      "permanent": true
    },
    {
      "source": "/maskapai",
      "destination": "/airlines",
      "permanent": true
    },
    {
      "source": "/pesawat",
      "destination": "/aircraft",
      "permanent": true
    },
    {
      "source": "/rute",
      "destination": "/routes",
      "permanent": true
    },
    {
      "source": "/artikel",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/tentang",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/kontak",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
